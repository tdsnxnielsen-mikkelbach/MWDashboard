@page "/resellers"
@using Color = MudBlazor.Color
@using Size = MudBlazor.Size
@inject IIonSyncService IonSync
@inject IPartnerCenterSyncService PcSync
@inject IMauDataService DataService
@inject TenantFilterService TenantFilter
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager

<BrandedPageTitle Page="Resellers & ION" />

@if (!TenantFilter.IsHomeTenantUser)
{
    NavigationManager.NavigateTo("/", replace: true);
    return;
}

<div class="d-flex justify-space-between align-center mb-4">
    <MudText Typo="Typo.h4">Resellers &amp; ION Pricing</MudText>
</div>

<MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
    Data sourced from the <strong>TD SYNNEX ION Gateway</strong> (StreamOne). Import indirect resellers and their end
    customers, then enrich the Microsoft license data with cost, margin and list price. Onboarded ION customers are
    <strong>pricing-only</strong> — they never enter Microsoft Graph collection or portal sign-in.
</MudText>

@if (!IonSync.Enabled)
{
    <MudAlert Severity="Severity.Warning" Class="mb-4">
        The ION Gateway is not configured. Set <code>IonGateway:ApiKey</code> (user-secrets in dev, Key Vault in prod) to enable pricing enrichment.
    </MudAlert>
}

@if (!PcSync.Enabled)
{
    <MudAlert Severity="Severity.Warning" Class="mb-4">
        The Partner Center API is not configured. Set <code>PartnerCenter:ApiKey</code> (user-secrets in dev, Key Vault in prod) to onboard reseller customers with their tenant + fused pricing.
    </MudAlert>
}

@* Sync actions *@
<MudPaper Class="pa-4 mb-4" Elevation="2">
    <MudText Typo="Typo.h6" Class="mb-3">Sync from ION Gateway</MudText>
    <div class="d-flex flex-wrap gap-3">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(_busy || !IonSync.Enabled)"
                   StartIcon="@Icons.Material.Filled.Storefront" OnClick="SyncResellers">Sync Resellers</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Secondary" Disabled="@(_busy || !IonSync.Enabled)"
                   StartIcon="@Icons.Material.Filled.GroupAdd" OnClick="SyncCustomers">Onboard ION Customers</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Tertiary" Disabled="@(_busy || !IonSync.Enabled)"
                   StartIcon="@Icons.Material.Filled.PriceCheck" OnClick="SyncPricing">Refresh Customer Pricing</MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Disabled="@(_busy || !IonSync.Enabled)"
                   StartIcon="@Icons.Material.Filled.ReceiptLong" OnClick="SyncResellerPricing">Crawl Reseller Orders</MudButton>
    </div>
    <MudDivider Class="my-3" />
    <MudText Typo="Typo.subtitle2" Class="mb-2">Partner Center (tenant-addressable customers + fused pricing)</MudText>
    <div class="d-flex flex-wrap gap-3">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(_busy || !PcSync.Enabled)"
                   StartIcon="@Icons.Material.Filled.Link" OnClick="SyncPctResellers">Match Resellers (MPN)</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Secondary" Disabled="@(_busy || !PcSync.Enabled)"
                   StartIcon="@Icons.Material.Filled.CloudSync" OnClick="SyncPctCustomers">Onboard Customers + Pricing</MudButton>
    </div>
    @if (_busy)
    {
        <div class="mt-3">
            <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-2" />
            <MudText Typo="Typo.caption" Color="Color.Secondary">@_busyMessage</MudText>
        </div>
    }
</MudPaper>

@* KPI cards *@
<MudGrid Class="mb-4">
    <MudItem xs="6" md="3">
        <MudPaper Class="pa-4" Elevation="2">
            <MudText Typo="Typo.subtitle2" Color="Color.Primary">Resellers</MudText>
            <MudText Typo="Typo.h4">@_resellers.Count.ToString("N0")</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="6" md="3">
        <MudPaper Class="pa-4" Elevation="2">
            <MudText Typo="Typo.subtitle2" Color="Color.Primary">ION Customers</MudText>
            <MudText Typo="Typo.h4">@_ionCustomers.Count.ToString("N0")</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="6" md="3">
        <MudPaper Class="pa-4" Elevation="2">
            <MudText Typo="Typo.subtitle2" Color="Color.Primary">Pricing-only</MudText>
            <MudText Typo="Typo.h4">@_ionCustomers.Count(c => c.PricingOnly).ToString("N0")</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="6" md="3">
        <MudPaper Class="pa-4" Elevation="2">
            <MudText Typo="Typo.subtitle2" Color="Color.Primary">Reseller SKU prices</MudText>
            <MudText Typo="Typo.h4">@_resellerPricing.Count.ToString("N0")</MudText>
        </MudPaper>
    </MudItem>
</MudGrid>

<MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" Class="mt-2">
    @* Resellers directory *@
    <MudTabPanel Text="Resellers" Icon="@Icons.Material.Filled.Storefront">
        @if (_resellers.Count == 0)
        {
            <MudAlert Severity="Severity.Info" Dense="true">No resellers imported yet. Click <strong>Sync Resellers</strong>.</MudAlert>
        }
        else
        {
            <MudTable Items="_resellers" Dense="true" Hover="true" Striped="true" Filter="new Func<IonReseller,bool>(FilterReseller)" Breakpoint="Breakpoint.Sm" @bind-RowsPerPage="_pageSize">
                <ToolBarContent>
                    <MudTextField @bind-Value="_resellerSearch" Placeholder="Search reseller..." Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0" />
                </ToolBarContent>
                <HeaderContent>
                    <MudTh><MudTableSortLabel SortBy="new Func<IonReseller,object>(x => x.Name)">Reseller</MudTableSortLabel></MudTh>
                    <MudTh>Contact</MudTh>
                    <MudTh>MPN</MudTh>
                    <MudTh Style="text-align:right"><MudTableSortLabel SortBy="new Func<IonReseller,object>(x => x.AccountId)">Account</MudTableSortLabel></MudTh>
                    <MudTh>Delegated Admin</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Reseller">@context.Name</MudTd>
                    <MudTd DataLabel="Contact">@context.PrimaryContactEmail</MudTd>
                    <MudTd DataLabel="MPN">@(string.IsNullOrEmpty(context.MpnId) ? "—" : context.MpnId)</MudTd>
                    <MudTd DataLabel="Account" Style="text-align:right">@context.AccountId</MudTd>
                    <MudTd DataLabel="Delegated Admin">
                        @if (context.DelegatedAdminEnabled) { <MudChip T="string" Size="Size.Small" Color="Color.Success">Enabled</MudChip> }
                        else { <MudChip T="string" Size="Size.Small" Color="Color.Default">No</MudChip> }
                    </MudTd>
                </RowTemplate>
                <PagerContent><MudTablePager PageSizeOptions="new[] { 25, 50, 100 }" /></PagerContent>
            </MudTable>
        }
    </MudTabPanel>

    @* ION customers *@
    <MudTabPanel Text="ION Customers" Icon="@Icons.Material.Filled.Groups">
        @if (_ionCustomers.Count == 0)
        {
            <MudAlert Severity="Severity.Info" Dense="true">No ION customers onboarded yet. Click <strong>Onboard ION Customers</strong>.</MudAlert>
        }
        else
        {
            <MudTable Items="_ionCustomers" Dense="true" Hover="true" Striped="true" Filter="new Func<TenantInfo,bool>(FilterCustomer)" Breakpoint="Breakpoint.Sm" @bind-RowsPerPage="_pageSize">
                <ToolBarContent>
                    <MudTextField @bind-Value="_customerSearch" Placeholder="Search customer / reseller..." Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0" />
                </ToolBarContent>
                <HeaderContent>
                    <MudTh><MudTableSortLabel SortBy="new Func<TenantInfo,object>(x => x.TenantName)">Customer</MudTableSortLabel></MudTh>
                    <MudTh><MudTableSortLabel SortBy="new Func<TenantInfo,object>(x => x.ResellerName)">Reseller</MudTableSortLabel></MudTh>
                    <MudTh>Source</MudTh>
                    <MudTh>Status</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Customer">
                        @context.TenantName
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block">@context.DisplayName</MudText>
                    </MudTd>
                    <MudTd DataLabel="Reseller">@(string.IsNullOrEmpty(context.ResellerName) ? "—" : context.ResellerName)</MudTd>
                    <MudTd DataLabel="Source">
                        <MudChip T="string" Size="Size.Small" Color="@(context.Source == "Native" ? Color.Primary : Color.Tertiary)">@context.Source</MudChip>
                    </MudTd>
                    <MudTd DataLabel="Status">
                        @if (context.PricingOnly) { <MudChip T="string" Size="Size.Small" Color="Color.Default">Pricing-only</MudChip> }
                        else if (context.IsActive) { <MudChip T="string" Size="Size.Small" Color="Color.Success">Consented</MudChip> }
                        else { <MudChip T="string" Size="Size.Small" Color="Color.Warning">Inactive</MudChip> }
                    </MudTd>
                </RowTemplate>
                <PagerContent><MudTablePager PageSizeOptions="new[] { 25, 50, 100 }" /></PagerContent>
            </MudTable>
        }
    </MudTabPanel>

    @* Reseller realised pricing *@
    <MudTabPanel Text="Reseller Pricing" Icon="@Icons.Material.Filled.ReceiptLong">
        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-3 d-block">
            Latest realised transacted price/cost/margin per SKU from each reseller's crawled orders. Keyed by ION
            account/customer id (indirect-reseller customers are not tenant-addressable), so this is distributor margin intelligence.
        </MudText>
        @if (_resellerPricing.Count == 0)
        {
            <MudAlert Severity="Severity.Info" Dense="true">No reseller order pricing yet. Click <strong>Crawl Reseller Orders</strong>.</MudAlert>
        }
        else
        {
            <MudTable Items="_resellerPricing" Dense="true" Hover="true" Striped="true" Filter="new Func<ResellerPricingSnapshot,bool>(FilterResellerPricing)" Breakpoint="Breakpoint.Sm" @bind-RowsPerPage="_pageSize">
                <ToolBarContent>
                    <MudTextField @bind-Value="_pricingSearch" Placeholder="Search reseller / SKU..." Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0" />
                </ToolBarContent>
                <HeaderContent>
                    <MudTh><MudTableSortLabel SortBy="new Func<ResellerPricingSnapshot,object>(x => x.ResellerName)">Reseller</MudTableSortLabel></MudTh>
                    <MudTh>Product</MudTh>
                    <MudTh Style="text-align:right">Qty</MudTh>
                    <MudTh Style="text-align:right">Price</MudTh>
                    <MudTh Style="text-align:right">Cost</MudTh>
                    <MudTh Style="text-align:right"><MudTableSortLabel SortBy="new Func<ResellerPricingSnapshot,object>(x => x.MarginPct ?? 0)">Margin %</MudTableSortLabel></MudTh>
                    <MudTh Style="text-align:right">Last Order</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Reseller">@context.ResellerName</MudTd>
                    <MudTd DataLabel="Product">
                        @(string.IsNullOrEmpty(context.ProductName) ? context.MfgPartNumber : context.ProductName)
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block">@context.SkuName</MudText>
                    </MudTd>
                    <MudTd DataLabel="Qty" Style="text-align:right">@context.Quantity.ToString("N0")</MudTd>
                    <MudTd DataLabel="Price" Style="text-align:right">@Money(context.UnitPrice, context.Currency)</MudTd>
                    <MudTd DataLabel="Cost" Style="text-align:right">@Money(context.UnitCost, context.Currency)</MudTd>
                    <MudTd DataLabel="Margin %" Style="text-align:right">
                        @if (context.MarginPct.HasValue)
                        {
                            <MudText Typo="Typo.body2" Color="@(context.MarginPct >= 0 ? Color.Success : Color.Error)">@context.MarginPct.Value.ToString("F1")%</MudText>
                        }
                        else { <span>—</span> }
                    </MudTd>
                    <MudTd DataLabel="Last Order" Style="text-align:right">@(context.LastOrderDate?.ToString("yyyy-MM-dd") ?? "—")</MudTd>
                </RowTemplate>
                <PagerContent><MudTablePager PageSizeOptions="new[] { 25, 50, 100 }" /></PagerContent>
            </MudTable>
        }
    </MudTabPanel>
</MudTabs>

@code {
    private List<IonReseller> _resellers = [];
    private List<TenantInfo> _ionCustomers = [];
    private List<ResellerPricingSnapshot> _resellerPricing = [];
    private bool _busy;
    private string _busyMessage = "";
    private int _pageSize = 25;
    private string _resellerSearch = "", _customerSearch = "", _pricingSearch = "";

    protected override async Task OnInitializedAsync() => await LoadAll();

    private async Task LoadAll()
    {
        _resellers = await DataService.GetResellersAsync();
        _ionCustomers = await DataService.GetIonCustomersAsync();
        _resellerPricing = (await DataService.GetLatestResellerPricingAsync())
            .OrderByDescending(r => r.LineMargin ?? 0)
            .ToList();
        // Denormalize customer counts onto resellers for display.
        var counts = _ionCustomers.Where(c => c.IonAccountId.HasValue)
            .GroupBy(c => c.IonAccountId!.Value)
            .ToDictionary(g => g.Key, g => g.Count());
        foreach (var r in _resellers)
            r.CustomerCount = counts.TryGetValue(r.AccountId, out var n) ? n : r.CustomerCount;
    }

    private async Task Run(string message, Func<Task<string>> action)
    {
        _busy = true;
        _busyMessage = message;
        StateHasChanged();
        try
        {
            var result = await action();
            await LoadAll();
            Snackbar.Add(result, Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"ION sync failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _busy = false;
            StateHasChanged();
        }
    }

    private Task SyncResellers() => Run("Syncing reseller directory...", async () =>
    {
        var n = await IonSync.SyncResellersAsync();
        return $"Synced {n} resellers.";
    });

    private Task SyncCustomers() => Run("Onboarding ION customers (this can take a moment)...", async () =>
    {
        var (added, annotated) = await IonSync.SyncCustomersAsync();
        return $"Onboarded {added} new customers, annotated {annotated} existing.";
    });

    private Task SyncPricing() => Run("Refreshing customer pricing from ION...", async () =>
    {
        var n = await IonSync.SyncCustomerPricingAsync();
        return $"Priced {n} customers.";
    });

    private Task SyncResellerPricing() => Run("Crawling reseller orders (all resellers)...", async () =>
    {
        var n = await IonSync.SyncResellerPricingAsync();
        return $"Wrote {n} reseller-pricing rows.";
    });

    private Task SyncPctResellers() => Run("Matching Partner Center resellers (MPN)...", async () =>
    {
        var n = await PcSync.SyncResellersAsync();
        return $"Matched {n} resellers to Partner Center (MPN + id).";
    });

    private Task SyncPctCustomers() => Run("Onboarding reseller customers + pricing from Partner Center (this can take a while)...", async () =>
    {
        var (onboarded, priced) = await PcSync.SyncCustomersAndPricingAsync();
        return $"Onboarded {onboarded} customers, priced {priced}.";
    });

    private bool FilterReseller(IonReseller r) =>
        string.IsNullOrWhiteSpace(_resellerSearch)
        || (r.Name?.Contains(_resellerSearch, StringComparison.OrdinalIgnoreCase) ?? false)
        || (r.PrimaryContactEmail?.Contains(_resellerSearch, StringComparison.OrdinalIgnoreCase) ?? false);

    private bool FilterCustomer(TenantInfo t) =>
        string.IsNullOrWhiteSpace(_customerSearch)
        || t.TenantName.Contains(_customerSearch, StringComparison.OrdinalIgnoreCase)
        || t.DisplayName.Contains(_customerSearch, StringComparison.OrdinalIgnoreCase)
        || t.ResellerName.Contains(_customerSearch, StringComparison.OrdinalIgnoreCase);

    private bool FilterResellerPricing(ResellerPricingSnapshot r) =>
        string.IsNullOrWhiteSpace(_pricingSearch)
        || r.ResellerName.Contains(_pricingSearch, StringComparison.OrdinalIgnoreCase)
        || r.ProductName.Contains(_pricingSearch, StringComparison.OrdinalIgnoreCase)
        || r.MfgPartNumber.Contains(_pricingSearch, StringComparison.OrdinalIgnoreCase);

    private static string Money(decimal? amount, string? currency)
        => amount.HasValue ? (string.IsNullOrEmpty(currency) ? amount.Value.ToString("N2") : $"{amount.Value:N2} {currency}") : "—";
}
