@page "/api"
@using Color = MudBlazor.Color
@inject TenantFilterService TenantFilter

<BrandedPageTitle Page="API" />

@if (!TenantFilter.IsHomeTenantUser)
{
    NavigationManager.NavigateTo("/", replace: true);
    return;
}

<div class="d-flex justify-space-between align-center mb-2">
    <MudText Typo="Typo.h4" data-tour="page-header">API Reference</MudText>
</div>
<MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
    Interactive OpenAPI reference (Scalar) for the dashboard and collector APIs. Browsing is open;
    to call a protected endpoint, set the API key under <strong>Authentication</strong> (sent as the X-API-Key header).
</MudText>

<iframe src="/scalar" title="API Reference"
        style="width:100%;height:calc(100vh - 200px);border:0;border-radius:8px;"></iframe>

@code {
    [Inject] private NavigationManager NavigationManager { get; set; } = default!;
}
